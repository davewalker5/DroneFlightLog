<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - Drone Flight Log</title>
    <link rel="stylesheet" href="~/lib/gijgo/dist/modular/css/core.css" />
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="~/css/site.css" />
    <link rel="stylesheet" href="~/lib/fontawesome/css/all.min.css" />
    <link rel="stylesheet" href="~/lib/datatables/datatables.min.css" />
    <link rel="stylesheet" href="~/lib/gijgo/dist/modular/css/datepicker.css" />
    <link rel="stylesheet" href="~/lib/gijgo/dist/modular/css/timepicker.css" />
    @RenderSection("Styles", required: false)
    <script src="~/lib/jquery/dist/jquery.js" type="text/javascript"></script>
    <script src="~/lib/gijgo/dist/modular/js/core.js" type="text/javascript"></script>
    <script src="~/lib/gijgo/dist/modular/js/datepicker.js" type="text/javascript"></script>
    <script src="~/lib/gijgo/dist/modular/js/timepicker.js" type="text/javascript"></script>
</head>
<body>
    <div class="app-shell">
    <header class="app-header">
        <nav class="navbar navbar-expand-lg navbar-dark">
            <div class="app-container">
                <a class="navbar-brand" asp-area="" asp-controller="Home" asp-action="Index" aria-label="Drone Flight Log home">
                    <span class="brand-mark" aria-hidden="true"><i class="fas fa-paper-plane"></i></span>
                    <span class="brand-copy">
                        <strong>Drone Flight Log</strong>
                        <small>Flight operations journal</small>
                    </span>
                </a>
                <button class="navbar-toggler" type="button" data-toggle="collapse" data-target=".navbar-collapse" aria-controls="navbarSupportedContent"
                        aria-expanded="false" aria-label="Toggle navigation">
                    <span class="navbar-toggler-icon"></span>
                </button>
                <div class="navbar-collapse collapse">
                    <ul class="navbar-nav ml-auto">
                        @if (User.Identity.IsAuthenticated)
                        {
                            <li class="nav-item">
                                <a class="nav-link" asp-area="" asp-controller="Flights" asp-action="Add">Log Flight</a>
                            </li>
                            <li class="nav-item dropdown">
                                <a class="nav-link dropdown-toggle" href="#" id="flightSearchMenu" role="button" data-toggle="dropdown" aria-haspopup="true" aria-expanded="false">
                                    Flight Search
                                </a>
                                <div class="dropdown-menu" aria-labelledby="flightSearchMenu">
                                    <a class="dropdown-item" asp-area="" asp-controller="AllFlights" asp-action="Index">All Flights</a>
                                    <a class="dropdown-item" asp-area="" asp-controller="SearchFlightsByOperator" asp-action="Index">Flights By Operator</a>
                                    <a class="dropdown-item" asp-area="" asp-controller="SearchFlightsByDrone" asp-action="Index">Flights By Drone</a>
                                    <a class="dropdown-item" asp-area="" asp-controller="SearchFlightsByLocation" asp-action="Index">Flights By Locations</a>
                                    <a class="dropdown-item" asp-area="" asp-controller="SearchFlightsByDate" asp-action="Index">Flights By Date</a>
                                </div>
                            </li>
                            <li class="nav-item dropdown">
                                <a class="nav-link dropdown-toggle" href="#" id="dataMaintenanceMenu" role="button" data-toggle="dropdown" aria-haspopup="true" aria-expanded="false">
                                    Data Maintenance
                                </a>
                                <div class="dropdown-menu dropdown-menu-right" aria-labelledby="dataMaintenanceMenu">
                                    <a class="dropdown-item" asp-area="" asp-controller="Manufacturers" asp-action="Index">Manufacturers</a>
                                    <a class="dropdown-item" asp-area="" asp-controller="Models" asp-action="Index">Models</a>
                                    <a class="dropdown-item" asp-area="" asp-controller="Drones" asp-action="Index">Drones</a>
                                    <div class="dropdown-divider"></div>
                                    <a class="dropdown-item" asp-area="" asp-controller="Locations" asp-action="Index">Flight Locations</a>
                                    <a class="dropdown-item" asp-area="" asp-controller="FlightProperties" asp-action="Index">Flight Properties</a>
                                    <a class="dropdown-item" asp-area="" asp-controller="Operators" asp-action="Index">Operators</a>
                                    <div class="dropdown-divider"></div>
                                    <a class="dropdown-item" asp-area="" asp-controller="Maintainers" asp-action="Index">Maintainers</a>
                                    <a class="dropdown-item" asp-area="" asp-controller="MaintenanceRecordsSearch" asp-action="Index">Maintenance Records</a>
                                </div>
                            </li>
                            <li class="nav-item">
                                <a class="nav-link" asp-area="" asp-controller="Login" asp-action="LogOut">Log Out</a>
                            </li>
                        }
                        else
                        {
                            <li class="nav-item">
                                <a class="nav-link" asp-area="" asp-controller="Login" asp-action="Index">Log In</a>
                            </li>
                        }
                    </ul>
                </div>
            </div>
        </nav>
    </header>
    <div class="app-container app-content">
        <div class="page-heading">
            <div>
                <p class="eyebrow">Drone Flight Log</p>
                <h1>@ViewData["Title"]</h1>
            </div>
        </div>
        <main role="main">
            @RenderBody()
        </main>
    </div>

    <footer class="app-footer">
        <div class="app-container footer-content">
            <span><i class="fas fa-paper-plane" aria-hidden="true"></i> Drone Flight Log</span>
            <span>&copy; 2020-2026 David Walker</span>
        </div>
    </footer>
    </div>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    <script src="~/js/site.js" asp-append-version="true"></script>
    <script src="~/lib/datatables/datatables.min.js"></script>
    @RenderSection("Scripts", required: false)
</body>
</html>
